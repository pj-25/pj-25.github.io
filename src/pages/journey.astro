---
import Base from '../layouts/Base.astro';
import journey from '../data/journey.json';
import EvidenceMark from '../components/EvidenceMark.astro';
---
<Base title="Journey" description="From Turbo C chess to agentic systems: each step links to the work.">
  <h1>Journey</h1>
  <p class="lede">Curiosity → experimentation → engineering → product thinking → systems → AI-native engineering. Every entry links to evidence, or says why it can't.</p>
  <ol class="timeline">
    {journey.map(j => (
      <li>
        <span class="meta">{j.year} · {j.chapter}<span class="meta-sep"> · </span><EvidenceMark {...j.evidence} /></span>
        <h2 class="entry-title">{j.title}</h2>
        <p class="entry-detail">{j.detail}</p>
        {j.links.length > 0 && <p class="links">{j.links.map(l => <a href={l.href}>{l.label}</a>)}</p>}
      </li>
    ))}
  </ol>
</Base>
